# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Greenfield setup (Vercel + Neon + Mac worker): see DEPLOY.md

# Shared secret for Mac mini worker → CRM API auth
WORKER_API_KEY=generate_a_long_random_string_here

# Admin suite login (defaults to WORKER_API_KEY if unset)
ADMIN_PASSWORD=your_admin_password_here

# Apollo.io — required for Enrich button on Jobs / Companies (add to Vercel too)
APOLLO_API_KEY=

# ContactOut API — personal email/mobile via LinkedIn (worker + Vercel Enrich button)
CONTACTOUT_API_KEY=

# Internal daily safety caps on estimated enrichment credits (per business day,
# midnight ET). These are app guardrails so a bug can't drain a provider
# balance — they are NOT the provider's real credit balance. Each enriched
# contact costs ~2 ContactOut credits (email + phone lookups).
# APOLLO_DAILY_CREDIT_CAP=200
# CONTACTOUT_DAILY_CREDIT_CAP=150

# SerpApi — Google Jobs API (JobSpy Google scraper is broken / unused).
# Key belongs on the Mac worker (`~/.vsearch/worker.env`). Google runs on the
# 5 AM scrape by default (weekday schedule gate); leave bypass unset in prod.
# ALSO NEEDED ON VERCEL if SERPAPI_DISCOVERY_ENABLED is turned on below — the
# CRM cannot reach the worker's copy. Same key, same value.
# https://serpapi.com/manage-api-key
# SERPAPI_API_KEY=
# SERPAPI_GOOGLE_MAX_PAGES=3
# SERPAPI_GOOGLE_ENABLED=1

# ---------------------------------------------------------------------------
# SerpApi Google Maps as a supplementary company discovery source.
# Design + cost comparison: docs/discovery-serpapi-source.md
#
# OFF BY DEFAULT, and the key alone never enables it. Apollo organization
# search stays the primary source; Maps only adds coverage of small local firms
# Apollo has no row for, with a real main-line phone. Maps NEVER returns
# headcount, so everything it finds lands in the size-unknown review pool.
#
# Searches come out of the SAME monthly SerpApi plan the Google Jobs scrape
# uses (SERPAPI_MONTHLY_PLAN above defaults to the 15,000/mo Production plan),
# so enabling this takes searches away from the job scrape. Start with one
# vertical in one market and read the run summary before widening.
# SERPAPI_DISCOVERY_ENABLED=true
#
# Verticals to sweep, comma-separated. Defaults to construction,legal —
# roofing/HVAC/plumbing/law firms are Google-Business-Profile-native. Finance
# and general_professional are deliberately excluded: their keywords do not map
# onto Google Business categories, and a query that returns noise still bills.
# SERPAPI_DISCOVERY_VERTICALS=construction,legal
#
# Hard ceiling on SerpApi searches for ONE discovery run (20 results each).
# SERPAPI_DISCOVERY_RUN_CAP=12
#
# Daily hard stop on ALL SerpApi searches the app can see, discovery plus the
# worker's Google Jobs scrape (both post to provider_usage_events). Same
# guardrail shape as APOLLO_/CONTACTOUT_DAILY_CREDIT_CAP above; the unit here is
# a search, not a credit. Default 400 ≈ the guarded monthly budget
# (15,000 × 0.8) spread over a month.
# SERPAPI_DAILY_CREDIT_CAP=400
# ---------------------------------------------------------------------------

# Public app URL (canonical CRM host — never legacy v-executive-search.vercel.app)
NEXT_PUBLIC_APP_URL=https://v-executive-search-delta.vercel.app

# Resend.com for daily email reports (optional on Vercel; required on worker)
RESEND_API_KEY=

# Demo request form on the marketing landing page (defaults to tech@vexecutivesearch.com)
# Requires RESEND_API_KEY on Vercel for delivery (otherwise the form falls back to mailto).
# DEMO_REQUEST_EMAIL=tech@vexecutivesearch.com

# Anthropic Haiku — call openers + activity summaries
ANTHROPIC_API_KEY=
# OPENER_MODEL=claude-haiku-4-5-20251001
# OPENER_MAX_PER_RUN=25

# Positive auto-replies include this Calendly (or other) booking URL on its own line.
# The copy reads the call length off the slug ("/15m" → "grab any 15 min"), so point
# this at the event type you actually want booked.
# Defaults to https://calendly.com/odv-vexecutivesearch/15m when unset.
# OUTREACH_SCHEDULING_LINK=https://calendly.com/odv-vexecutivesearch/15m

# Calendly webhook → Call List "Call Booked" (see DEPLOY.md Outreach Sequencer §4)
# Required for ?token= auth on /api/webhooks/calendly (same value on Vercel + Calendly URL)
CALENDLY_WEBHOOK_SECRET=
# Optional: Calendly-Webhook-Signature HMAC (from Calendly webhook signing key)
# CALENDLY_WEBHOOK_SIGNING_KEY=
# Optional: hydrate start/end when payload only has scheduled_event URI
# CALENDLY_API_TOKEN=

# ---------------------------------------------------------------------------
# Twilio A2P 10DLC SMS (replaces the Mac mini iMessage path)
#
# LEAVE OUTREACH_SMS_ENABLED UNSET UNTIL THE A2P 10DLC BRAND *AND* CAMPAIGN ARE
# APPROVED. Since Feb 2025 US carriers block unregistered A2P traffic outright,
# so enabling early does not send slowly — it sends nothing and burns the
# number's reputation. Credentials alone never start traffic: the code also
# requires this flag, and the DB kill switch (Admin → Outreach) still applies.
# OUTREACH_SMS_ENABLED=true
#
# Optional, defaults to twilio (telnyx/plivo would be added as new providers).
# SMS_PROVIDER=twilio
#
# Account identifier (starts AC…) — not a secret, but required.
TWILIO_ACCOUNT_SID=
# Preferred credential: an API key pair, revocable on its own. The Auth Token is
# the account root credential — revoking it breaks every other integration.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Fallback for sending when no API key pair is set. ALSO REQUIRED FOR INBOUND:
# X-Twilio-Signature is keyed on the Auth Token, an API key secret cannot verify
# it, and /api/webhooks/twilio rejects everything while this is unset.
TWILIO_AUTH_TOKEN=
# Messaging Service SID (starts MG…) — this is what carries the A2P campaign
# registration, so send through it whenever it exists. TWILIO_FROM_NUMBER (E.164)
# is only for a number that is not yet campaign-bound.
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=+15615550123
#
# Only if the forwarded proto/host ever disagree with what Twilio signed: the
# exact webhook URL configured in the Twilio console.
# TWILIO_WEBHOOK_URL=https://v-executive-search-delta.vercel.app/api/webhooks/twilio
# Per-message delivery callbacks. Usually configured on the Messaging Service
# instead; set this only when sending from a bare number.
# TWILIO_STATUS_CALLBACK_URL=https://v-executive-search-delta.vercel.app/api/webhooks/twilio
# ---------------------------------------------------------------------------

# Vercel Cron auth for /api/cron/check-worker (auto-set on Vercel when crons are enabled)
CRON_SECRET=

# HMAC key for List-Unsubscribe one-click links (falls back to WORKER_API_KEY).
# Requires NEXT_PUBLIC_APP_URL for the link host; header omitted if either is missing.
# OUTREACH_UNSUBSCRIBE_SECRET=
